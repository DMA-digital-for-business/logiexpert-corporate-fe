# ── Backend form / invio candidature ────────────────────────────────────────
# Provider email transazionale: Amazon SES (vedi lib/mailer.js).
# Copiare in .env.local e valorizzare prima del go-live del form candidature.

# Regione SES (deve coincidere con la regione dove il mittente/dominio è verificato)
AWS_REGION=eu-central-1

# Credenziali IAM con permesso ses:SendRawEmail.
# In produzione si può usare un IAM Role al posto delle chiavi (lasciare vuote).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mittente VERIFICATO in SES (email o indirizzo su dominio verificato)
SES_FROM=no-reply@logiexpert.com
SES_FROM_NAME=LogiExpert

# Destinatari delle candidature (separati da virgola)
CAREERS_MAIL_TO=marco.maffina@logiexpert.com,guido.dameri@logiexpert.com

# ── Area interna (/interno/*) — HTTP Basic Auth ─────────────────────────────
# Credenziali per accedere ai documenti riservati (es. manuale operativo).
# Se non valorizzate, l'accesso è negato di default (fail-closed).
INTERNAL_DOCS_USER=logiexpert
INTERNAL_DOCS_PASSWORD=
